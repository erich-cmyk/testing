# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CMS Configuration (WordPress REST API)
CMS_TYPE=wordpress
CMS_BASE_URL=https://your-site.com
CMS_USERNAME=your_wp_username
CMS_APP_PASSWORD=your_wp_application_password

# Optional: Tavily Search API (better web search results)
# If not set, falls back to Claude's built-in web search
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Settings
MAX_SEARCH_RESULTS=10
MAX_COMPETITORS=5
KEYWORD_TARGET_COUNT=30
